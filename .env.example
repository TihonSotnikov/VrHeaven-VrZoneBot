# --- обязательное ---

# Токен бота от @BotFather. Для разработки — ОТДЕЛЬНЫЙ бот: Telegram отдаёт
# апдейты одному потребителю, боевой токен здесь уведёт их у сервера.
BOT_TOKEN=

# Telegram ID супер-админов через запятую (узнать свой: @userinfobot).
# Эти записи нельзя убрать из бота — это восстановление доступа.
# Остальных супер-админов заводят в разделе «Доступ VR Heaven».
ADMIN_IDS=

# --- необязательное ---

# Часовой пояс расписаний: скидка, серии, плановые задачи
TIMEZONE=Europe/Moscow

# Файл базы и каталог данных (блокировка запуска, копии)
DB_PATH=adminbot.db
# DATA_DIR=
# BACKUP_DIR=

# Ротация копий: все за N дней, по одной на неделю и на месяц
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=8
# BACKUP_KEEP_MONTHS=12

# Команда выгрузки копии за пределы сервера; получает {path} и {name}.
# Не задана — копия уходит только документом супер-админам в Telegram.
# BACKUP_OFFHOST_CMD=rclone copy {path} remote:vrheaven-backups/

# Журналирование
# LOG_JSON=false
# LOG_LEVEL=INFO

# Вместо BOT_TOKEN можно указать файл с токеном; на сервере токен
# приходит через LoadCredential systemd и здесь не нужен вовсе.
# BOT_TOKEN_FILE=/etc/vrheaven-bot/bot_token
